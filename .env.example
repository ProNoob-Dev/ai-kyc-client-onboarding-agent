# Copy to .env and fill in what you need. Never commit a real .env.
# cp .env.example .env

# LLM provider: "mock" (default — offline, deterministic) or "azure".
LLM_PROVIDER=mock

# Azure OpenAI — only needed when LLM_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=<redacted>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Document Intelligence — only needed to extract fields from real
# document files. The API accepts pre-extracted text, so onboarding
# works fully offline without it.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=<redacted>

# Persistence: Postgres when set (docker compose sets this), otherwise
# the local JSON store in data/ is used.
DATABASE_URL=

# KYC policy.
# Address proof must be dated within this many days of submission.
ADDRESS_PROOF_MAX_AGE_DAYS=90

# Server.
HOST=0.0.0.0
PORT=8000
